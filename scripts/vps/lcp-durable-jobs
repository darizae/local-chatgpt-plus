#!/usr/bin/python3 -I
"""Independent non-root job supervisor. Private local RPC; no automatic replay."""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import socket
import socketserver
import struct
import subprocess
import threading
import time
import uuid

MAX_WIRE = 4_000_000
MAX_LOG = 512_000  # bytes per stream per job, bounded private spool
MAX_HISTORY = 250
ID = re.compile(r"dur-[0-9a-f]{32}\Z")

def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()

class Jobs:
    def __init__(self, root, state):
        self.root = root.resolve()
        self.state = state.resolve()
        self.state.mkdir(mode=0o700, parents=True, exist_ok=True)
        if self.state.stat().st_mode & 0o077:
            raise ValueError("job state must be private")
        self.lock = threading.RLock()
        self.records = {}
        self.children = {}
        self.inputs = {}
        for f in self.state.glob("dur-*/state.json"):
            if f.is_symlink() or f.parent.is_symlink() or not ID.fullmatch(f.parent.name):
                continue
            data = json.loads(f.read_text())
            if data.get("id") != f.parent.name:
                continue
            if data.get("running"):
                data.update(running=False, status="interrupted", finished_at=now(),
                            stdin_writable=False, exit_code=None, signal=None,liveness="exited")
                self.save(data)
            self.records[data["id"]] = data

    def save(self, record):
        directory = self.state / record["id"]
        directory.mkdir(mode=0o700, exist_ok=True)
        tmp = directory / ".state.next"
        with tmp.open("w") as f:
            json.dump(record, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, directory / "state.json")
        fd = os.open(directory, os.O_DIRECTORY)
        try: os.fsync(fd)
        finally: os.close(fd)

    def path(self, raw):
        if not isinstance(raw, str) or not Path(raw).is_absolute():
            raise ValueError("absolute workspace path required")
        p = Path(raw).resolve(strict=True)
        if not p.is_relative_to(self.root) or not p.is_dir():
            raise ValueError("outside authorized workspace")
        return str(p)

    def public(self, r):
        return {k:v for k,v in r.items() if k != "fingerprint"}

    def prune(self):
        import shutil
        finished = sorted((r for r in self.records.values() if not r["running"]), key=lambda r:r["started_at"], reverse=True)
        for r in finished[MAX_HISTORY:]:
            shutil.rmtree(self.state / r["id"])
            del self.records[r["id"]]

    def start(self, req):
        cwd = self.path(req.get("cwd"))
        project = req.get("project_root")
        if project is not None:
            project = self.path(project)
            if not Path(cwd).is_relative_to(project):
                # Worktrees use their canonical project root as reported by MCP.
                # Confirm Git common directory equivalence, not caller assertion.
                def common(p):
                    result = subprocess.run(["/usr/bin/git","-C",p,"rev-parse","--path-format=absolute","--git-common-dir"],capture_output=True,text=True,timeout=5)
                    return Path(result.stdout.strip()).resolve() if result.returncode == 0 else None
                a,b=common(cwd),common(project)
                if a is None or a != b or not a.is_relative_to(self.root):
                    raise ValueError("project/cwd scope mismatch")
        command=req.get("command")
        if not isinstance(command,str) or not command.strip() or len(command)>500000 or "\x00" in command:
            raise ValueError("invalid command")
        fields = {}
        for k,n in (("label",160),("task_id",200),("session_id",200)):
            val=req.get(k)
            if val is not None and (not isinstance(val,str) or len(val)>n):
                raise ValueError("invalid metadata")
            fields[k]=val
        fp=hashlib.sha256(json.dumps([cwd,project,command.strip(),fields["task_id"]],ensure_ascii=True).encode()).hexdigest()
        with self.lock:
            for r in self.records.values():
                if r["running"] and r["fingerprint"]==fp:
                    return {**self.public(r),"reused":True}
            jid="dur-"+uuid.uuid4().hex
            r={"id":jid,**fields,"cwd":cwd,"project_root":project,"command":"[command withheld]",
               "fingerprint":fp,"started_at":now(),"last_activity_at":now(),"running":True,
               "status":"running","pid":None,"stdin_writable":False,"exit_code":None,"signal":None,
               "durable":True,"liveness":"active"}
            self.save(r)
            self.records[jid]=r
            env={k:v for k,v in os.environ.items() if k in {
                "HOME","USER","LOGNAME","PATH","SHELL","LANG","TZ","XDG_CACHE_HOME","XDG_DATA_HOME","XDG_CONFIG_HOME","MPLCONFIGDIR","DOCKER_CONFIG",
                "npm_config_cache","PIP_CACHE_DIR","UV_CACHE_DIR","PLAYWRIGHT_BROWSERS_PATH","GIT_CONFIG_GLOBAL","DOCKER_HOST","SSL_CERT_FILE","SSL_CERT_DIR"} or re.fullmatch(r"LC_[A-Z_]+",k)}
            env.update(CI="true",PAGER="cat",GIT_PAGER="cat",NO_COLOR="1")
            try:
                child=subprocess.Popen(["/bin/bash","-lc",command],cwd=cwd,env=env,
                    stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)
            except OSError:
                r.update(running=False,status="failed",finished_at=now(),exit_code=1)
                self.save(r)
                raise ValueError("job shell could not start")
            self.children[jid]=child
            self.inputs[jid]=threading.Lock()
            r.update(pid=child.pid,stdin_writable=True)
            self.save(r)
            readers=[threading.Thread(target=self.drain,args=(jid,kind,pipe),daemon=True)
                     for kind,pipe in (("stdout",child.stdout),("stderr",child.stderr))]
            for t in readers: t.start()
            threading.Thread(target=self.reap,args=(jid,child,readers),daemon=True).start()
            return {**self.public(r),"reused":False}

    def drain(self,jid,kind,pipe):
        fpath=self.state/jid/(kind+".log")
        with pipe, fpath.open("wb") as f:
            size=0
            while True:
                data=os.read(pipe.fileno(),16384)
                if not data: break
                # Keep the most recent half when crossing the limit.
                if size+len(data)>MAX_LOG:
                    f.flush()
                    with fpath.open("rb") as old:
                        old.seek(max(0,size-MAX_LOG//2))
                        tail=old.read()
                    f.seek(0); f.truncate()
                    f.write(tail); size=len(tail)
                    with self.lock:
                        if jid in self.records: self.records[jid]["logs_truncated"]=True
                f.write(data); f.flush(); size+=len(data)
                with self.lock:
                    if jid in self.records: self.records[jid]["last_activity_at"]=now()

    def reap(self,jid,child,readers):
        code=child.wait()
        # A shell's descendants may inherit its pipes. Do not hang recovery.
        for t in readers: t.join(timeout=2)
        # A background command should keep its foreground process alive. Clean
        # up ordinary same-process-group descendants if the shell already exited.
        if any(t.is_alive() for t in readers):
            try: os.killpg(child.pid,signal.SIGTERM)
            except ProcessLookupError: pass
            for t in readers: t.join(timeout=1)
        with self.lock:
            r=self.records[jid]
            r.update(running=False,status="stopped" if r.get("stop_requested") or code<0 else "completed" if code==0 else "failed",
                exit_code=code if code>=0 else None,signal=signal.Signals(-code).name if code<0 else None,
                stdin_writable=False,finished_at=now(),liveness="exited")
            self.children.pop(jid,None)
            self.inputs.pop(jid,None)
            self.save(r)
            # Do not prune a log while a descendant still owns its pipe.
            if not any(t.is_alive() for t in readers): self.prune()

    def dispatch(self,req):
        action=req.get("action")
        if action=="ping": return {"ready":True}
        if action=="start": return self.start(req)
        if action=="list":
            with self.lock: return {"jobs":[self.public(r) for r in sorted(self.records.values(),key=lambda x:x["started_at"],reverse=True)]}
        jid=req.get("id")
        if not isinstance(jid,str) or not ID.fullmatch(jid): raise ValueError("invalid job id")
        with self.lock:
            if jid not in self.records: raise ValueError("unknown job")
            r=self.records[jid]
            child=self.children.get(jid)
            if action=="status": return self.public(r)
            if action=="output":
                limit=req.get("tail_chars",40000)
                if type(limit) is not int or not 1<=limit<=200000: raise ValueError("invalid output limit")
                out={}
                for kind in ("stdout","stderr"):
                    try:
                        with (self.state/jid/(kind+".log")).open("rb") as f:
                            f.seek(max(0,os.fstat(f.fileno()).st_size-limit*4))
                            out[kind]=f.read().decode("utf-8","replace")[-limit:]
                    except FileNotFoundError: out[kind]=""
                return {**self.public(r),**out,"truncated":bool(r.get("logs_truncated"))}
            if action=="stop":
                if child is not None and child.poll() is None:
                    r["stop_requested"]=True
                    self.save(r)
                    try: os.killpg(child.pid,signal.SIGKILL if req.get("force") is True else signal.SIGTERM)
                    except ProcessLookupError: pass
                return self.public(r)
            if action!="input": raise ValueError("unsupported operation")
            if child is None or not r["stdin_writable"]: raise ValueError("stdin closed")
            lock=self.inputs[jid]
        value=req.get("input")
        if not isinstance(value,str) or len(value)>100000: raise ValueError("invalid input")
        # Nonblocking pipe writes: never allow a waiting program to hang the RPC.
        with lock:
            import select
            fd=child.stdin.fileno()
            os.set_blocking(fd,False)
            data=value.encode()
            sent=0
            end=time.monotonic()+3
            while sent<len(data):
                if time.monotonic()>=end: break
                if not select.select([], [fd], [], 0.2)[1]: continue
                try: sent+=os.write(fd,data[sent:sent+4096])
                except BlockingIOError: continue
            if req.get("close_stdin") is True and sent==len(data):
                child.stdin.close()
                with self.lock: r["stdin_writable"]=False; self.save(r)
            return {"id":jid,"bytes_written":sent,"complete":sent==len(data)}

class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        self.request.settimeout(10)
        try:
            _,uid,_=struct.unpack("3i",self.request.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))
            if uid!=os.getuid(): raise ValueError("unauthorized peer")
            line=self.rfile.readline(MAX_WIRE+1)
            if not line.endswith(b"\n") or len(line)>MAX_WIRE: raise ValueError("invalid request size")
            req=json.loads(line)
            if not isinstance(req,dict): raise ValueError("invalid request")
            reply={"ok":True,"data":self.server.jobs.dispatch(req)}
        except (ValueError,OSError,KeyError,TypeError,subprocess.SubprocessError) as e:
            reply={"ok":False,"error":str(e)[:250] if isinstance(e,ValueError) else "job operation unavailable"}
        try: self.wfile.write((json.dumps(reply,ensure_ascii=False)+"\n").encode())
        except OSError: pass

class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads=True

def main():
    p=argparse.ArgumentParser()
    p.add_argument("--root",required=True,type=Path)
    p.add_argument("--state",required=True,type=Path)
    p.add_argument("--socket",required=True,type=Path)
    a=p.parse_args()
    if os.getuid()==0: raise SystemExit("job supervisor must not run as root")
    os.umask(0o077)
    if a.socket.exists() or a.socket.is_symlink():
        raise SystemExit("refuse to replace existing socket")
    jobs=Jobs(a.root,a.state)
    with Server(str(a.socket),Handler) as server:
        server.jobs=jobs
        os.chmod(a.socket,0o600)
        try: server.serve_forever()
        finally: a.socket.unlink(missing_ok=True)

if __name__=="__main__": main()
