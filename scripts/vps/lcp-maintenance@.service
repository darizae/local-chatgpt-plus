[Unit]
Description=Bounded host maintenance for existing LCP services

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/lcp-maintenance
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
Group=root
TimeoutStartSec=600
StateDirectory=lcp-maintenance
StateDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lcp-vps-control.lock
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
CapabilityBoundingSet=
