[Unit]
Description=Local fixed-operation MCP maintenance socket

[Socket]
ListenStream=/run/lcp-maintenance/agent.sock
DirectoryMode=0755
Accept=yes
SocketUser=agent
SocketGroup=agent
SocketMode=0600
RemoveOnStop=yes
MaxConnections=4
TriggerLimitIntervalSec=60
TriggerLimitBurst=60

[Install]
WantedBy=sockets.target
