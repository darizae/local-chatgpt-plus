#!/usr/bin/python3 -I
"""Client for the owner-approved, local-only bounded VPS model-job queue."""
import argparse
import json
import socket
import sys

SOCKET = '/run/lcp-agent-broker/agent.sock'
parser = argparse.ArgumentParser(description='Bounded model queue (never exposes provider secrets)')
sub = parser.add_subparsers(dest='action', required=True)
add = sub.add_parser('submit')
add.add_argument('--repo', required=True)
add.add_argument('--engine', choices=['omp', 'omp-readonly', 'selftest'], default='omp')
add.add_argument('--seconds', type=int, default=90)
add.add_argument('--cost', type=float, default=0.05)
sub.add_parser('capacity')
for name in ('status', 'cancel', 'result'):
    sub.add_parser(name).add_argument('id')
a = parser.parse_args()
request = vars(a)
if a.action == 'submit':
    prompt = sys.stdin.read(6002)
    request['prompt'] = prompt
payload = (json.dumps(request, ensure_ascii=True) + '\n').encode('utf-8')
if len(payload) > 14_000:
    parser.error('Request exceeds bounded broker limit')
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(8)
        sock.connect(SOCKET)
        sock.sendall(payload)
        response = sock.makefile('rb').readline(16_000)
    reply = json.loads(response)
except (OSError, ValueError) as exc:
    print('Local agent broker unavailable: ' + str(exc)[:160], file=sys.stderr)
    raise SystemExit(2)
print(json.dumps(reply, ensure_ascii=True))
if not reply.get('ok'):
    raise SystemExit(2)
