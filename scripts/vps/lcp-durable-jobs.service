[Unit]
Description=Independent LCP workspace job supervisor
After=network.target

[Service]
Type=simple
User=agent
Group=agent
RuntimeDirectory=lcp-durable-jobs
RuntimeDirectoryMode=0700
StateDirectory=lcp-durable-jobs
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/libexec/lcp-durable-jobs --root /home/agent/workspaces/projects --state /var/lib/lcp-durable-jobs --socket /run/lcp-durable-jobs/jobs.sock
Environment=HOME=/home/agent
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/agent/.local/bin:/home/agent/workspaces/projects/.lcp-cache/tools/node_modules/.bin
Environment=XDG_CACHE_HOME=/home/agent/workspaces/projects/.lcp-cache
Environment=XDG_DATA_HOME=/home/agent/workspaces/projects/.lcp-cache/data
Environment=npm_config_cache=/home/agent/workspaces/projects/.lcp-cache/npm
Environment=PIP_CACHE_DIR=/home/agent/workspaces/projects/.lcp-cache/pip
Environment=UV_CACHE_DIR=/home/agent/workspaces/projects/.lcp-cache/uv
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/agent/workspaces/projects/.lcp-cache/playwright
Environment=GIT_CONFIG_GLOBAL=/home/agent/workspaces/projects/.lcp-cache/gitconfig
Environment=DOCKER_HOST=unix:///run/lcp-dev-docker.sock
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/agent/workspaces/projects
InaccessiblePaths=-/home/agent/.ssh -/home/agent/.config/omp -/home/agent/.omp -/home/agent/.codex -/home/agent/.config/tunnel-client -/home/agent/.config/lcp-vps
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillMode=control-group
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
